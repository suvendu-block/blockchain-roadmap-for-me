# Express API server
PORT=5000
CORS_ORIGIN=http://localhost:5173

# MongoDB (local server installed via winget)
MONGO_URI=mongodb://127.0.0.1:27017/tipjar

# Ethereum node (Hardhat: `npm run chain`)
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337

# Leave empty to auto-detect from deployments/<chainId>.json
CONTRACT_ADDRESS=

# How often the server mirrors Tipped events into Mongo (ms)
INDEX_INTERVAL_MS=5000
